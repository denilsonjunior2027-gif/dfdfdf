    .bw-classic-game button { width: 100%; }
    .bw-classic-columns { display: grid; grid-template-columns: 2fr 1fr; gap: 18px; }
    .bw-classic-links { display: flex; gap: 8px; flex-wrap: wrap; }
    .bw-classic-links button { color: #245b8e; background: #edf5fc; border-color: #c3d9eb; }
    .bw-classic-footer { padding: 24px; text-align: center; color: #718095; font-size: 12px; line-height: 1.6; }
    #bwNoGames { color: var(--muted); }

    /* Editor BlockWorld existente */
    .app { display:grid; grid-template-rows:54px 44px minmax(0,1fr); height:100vh; background:#101522; color:#e6edf8; }
    .app-topbar,.app-toolbar { display:flex; align-items:center; gap:8px; padding:8px 14px; background:#1b2740; border-bottom:1px solid #34435e; flex-wrap:wrap; }
