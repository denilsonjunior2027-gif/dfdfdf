    #viewport { position:relative; flex:1; min-height:220px; overflow:hidden; background:#111720; }
    #scene { display:block; width:100%; height:100%; }
    .app-status { padding:8px 10px; background:#141d2d; border-top:1px solid #34435e; color:#9fe7b0; font-size:12px; }
    .app-lua-editor { display:flex; min-height:0; flex:1; background:#0c1220; }
    #lineNumbers { width:42px; flex-shrink:0; overflow:hidden; margin:0; padding:10px 7px; color:#65758e; background:#0a101c; text-align:right; white-space:pre; font:13px/1.55 Consolas,monospace; }
