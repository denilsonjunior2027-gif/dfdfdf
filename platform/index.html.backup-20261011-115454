<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BlockWorld Studio</title>
  <style>
    * { box-sizing: border-box; }
    :root {
      --blue: #1c5d99;
      --blue-dark: #164b7d;
      --blue-light: #347fb8;
      --border: #c7d0dc;
      --text: #303b4b;
      --muted: #667587;
    }
    html, body { min-height: 100%; margin: 0; }
    body { font-family: Arial, sans-serif; background: #e9edf2; color: var(--text); }
    button, input { font: inherit; }
    button {
      padding: 10px 14px; border: 1px solid #27699d; border-radius: 4px;
      background: var(--blue-light); color: #fff; font-weight: bold; cursor: pointer;
    }
    button:hover { background: #28699d; }
    button:focus-visible, input:focus-visible { outline: 2px solid #79b844; outline-offset: 2px; }
    .bw-home { position: fixed; inset: 0; z-index: 5000; overflow-y: auto; background: #e9edf2; color: var(--text); }
    .bw-home * { box-sizing: border-box; }
    .bw-classic-header {
      min-height: 58px; padding: 10px 5%; display: flex; align-items: center;
      gap: 22px; flex-wrap: wrap; color: #fff; background: var(--blue);
      border-bottom: 4px solid var(--blue-dark);
    }
    .bw-classic-logo { font-size: 24px; font-weight: bold; letter-spacing: -1px; white-space: nowrap; }
    .bw-classic-nav { display: flex; gap: 6px; flex-wrap: wrap; }
    .bw-classic-nav button, .bw-classic-header button { color: #fff; background: #286fae; border-color: #4b8bc2; }
    .bw-classic-nav button:hover, .bw-classic-header button:hover { background: #3985c7; }
    .bw-classic-search { display: flex; flex: 1; min-width: 180px; max-width: 360px; }
    .bw-classic-search input {
      width: 100%; min-width: 0; padding: 9px; border: 1px solid #a9b8c9;
      border-radius: 3px 0 0 3px;
    }
    .bw-classic-search button { border-radius: 0 3px 3px 0; }
    .bw-classic-content { width: min(1180px, 94%); margin: 24px auto; }
    .bw-classic-welcome {
      display: flex; justify-content: space-between; align-items: center; gap: 20px;
      flex-wrap: wrap; padding: 24px; color: #fff;
      background: linear-gradient(120deg, #2369a6, #438fc8);
      border: 1px solid #17568c; border-radius: 5px; box-shadow: 0 2px 4px #0002;
    }
    .bw-classic-welcome h1 { margin: 0 0 10px; font-size: clamp(24px, 4vw, 36px); }
    .bw-classic-welcome p { margin: 0; line-height: 1.6; color: #e0efff; }
    .bw-classic-primary { padding: 12px 18px; background: #79aF44; border-color: #619c31; }
    .bw-classic-primary:hover { background: #659b32; }
    .bw-classic-section {
      margin-top: 24px; padding: 16px; background: #fff; border: 1px solid var(--border);
      border-radius: 4px; box-shadow: 0 1px 2px #0001;
    }
    .bw-classic-section h2 {
      margin: 0 0 14px; padding-bottom: 10px; font-size: 20px;
      color: #245b8e; border-bottom: 1px solid #d6dee7;
    }
    .bw-classic-games { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
    .bw-classic-game { min-width: 0; overflow: hidden; border: 1px solid var(--border); background: #f8fafc; }
    .bw-classic-game[hidden] { display: none !important; }
    .bw-classic-game-art {
      aspect-ratio: 1.45; display: grid; place-items: center; font-size: 44px;
      background: linear-gradient(145deg, #b9dcf3, #6b9fc9); border-bottom: 1px solid var(--border);
