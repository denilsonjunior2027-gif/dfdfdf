    .bw-classic-game:nth-child(2) .bw-classic-game-art { background: linear-gradient(145deg, #c7e8a4, #65a65a); }
    .bw-classic-game:nth-child(3) .bw-classic-game-art { background: linear-gradient(145deg, #f8d5a4, #d98c61); }
    .bw-classic-game:nth-child(4) .bw-classic-game-art { background: linear-gradient(145deg, #d4c5f4, #8c77c4); }
