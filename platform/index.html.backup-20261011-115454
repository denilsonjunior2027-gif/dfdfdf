    #luaConsole { max-height:55px; overflow:auto; padding:7px 10px; color:#9fe7b0; background:#080d17; font:12px Consolas,monospace; white-space:pre-wrap; }
    .app-prop-label { display:block; margin:12px 0 5px; color:#b8c6df; font-size:12px; }
